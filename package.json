{
  "name": "codesh",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "TURBO_TELEMETRY_DISABLED=1 turbo run dev",
    "build": "TURBO_TELEMETRY_DISABLED=1 turbo run build",
    "check": "biome check . && TURBO_TELEMETRY_DISABLED=1 turbo run typecheck && vitest run && pnpm run licenses",
    "test": "vitest run",
    "test:e2e": "pnpm services:up && pnpm --filter @codesh/web test:e2e",
    "load": "pnpm --filter @codesh/load start",
    "bundle": "bash deploy/bundle.sh",
    "services:up": "docker compose -f deploy/docker-compose.dev.yml up -d --wait",
    "services:down": "docker compose -f deploy/docker-compose.dev.yml down",
    "licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "22.20.5",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
