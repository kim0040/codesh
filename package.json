{
  "name": "codesh",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "biome check . && turbo run typecheck && vitest run && pnpm run licenses",
    "test": "vitest run",
    "test:e2e": "echo 'e2e: Playwright is added with the first end-to-end test'",
    "load": "echo 'load: scripts/load is added with the collab load test'",
    "services:up": "docker compose -f deploy/docker-compose.dev.yml up -d --wait",
    "services:down": "docker compose -f deploy/docker-compose.dev.yml down",
    "licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "22.20.5",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
