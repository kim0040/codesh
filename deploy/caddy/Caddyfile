# gachipad edge: static web app, /api (incl. SSE) and /collab (WebSocket) -- docs/ARCHITECTURE.md §1.
#
# SITE_ADDRESS  ":80" (default) serves plain HTTP. A host name (gachipad.local) turns on HTTPS;
#               put a `tls ...` directive for it in /etc/caddy/tls/*.caddy (see deploy/README.md).
# TRUSTED_PROXIES  CIDRs of a load balancer in front of Caddy whose X-Forwarded-For is kept.
#               Without one Caddy replaces the header with the client address it sees.

{
	admin localhost:2019
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$SITE_ADDRESS::80}{$SITE_ALIASES} {
	import /etc/caddy/tls/*.caddy

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; script-src 'self' {$CSP_SCRIPT_HASHES}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
	}

	# Prometheus endpoints: loopback and the dedicated compose network only.
	@metrics_api {
		path /metrics/api
		remote_ip 127.0.0.0/8 ::1 {$METRICS_SUBNET:172.29.88.0/24}
	}
	handle @metrics_api {
		rewrite * /metrics
		reverse_proxy api:3001
	}
	@metrics_collab {
		path /metrics/collab
		remote_ip 127.0.0.0/8 ::1 {$METRICS_SUBNET:172.29.88.0/24}
	}
	handle @metrics_collab {
		rewrite * /metrics
		reverse_proxy {
			dynamic a {
				name collab
				port 3002
				refresh 5s
			}
		}
	}
	handle /metrics {
		respond "Forbidden" 403
	}
	handle /metrics/* {
		respond "Forbidden" 403
	}

	handle /healthz {
		reverse_proxy api:3001
	}
	handle /readyz {
		reverse_proxy api:3001
	}

	# REST and the SSE stream. flush_interval -1 sends every event as it is written.
	handle /api/* {
		reverse_proxy api:3001 {
			flush_interval -1
		}
	}

	# WebSocket. Every collab replica is an upstream (compose DNS returns one A record per
	# replica); `doc` in the query string picks the replica, so one document normally lives
	# on one instance (§1).
	handle /collab* {
		reverse_proxy {
			dynamic a {
				name collab
				port 3002
				refresh 5s
			}
			lb_policy query doc
			health_uri /healthz
			health_interval 5s
			health_timeout 2s
			flush_interval -1
		}
	}

	# Hashed build output: cached for a year.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		encode zstd gzip
		file_server
	}

	# Everything else is the SPA: files that exist (index.html, the service worker, manifest,
	# icons) are revalidated on every load; any other path gets index.html.
	# The app shell sends no Referer at all: a legacy `?key=` address must not leave in one
	# before the app has scrubbed it (docs/ARCHITECTURE.md §14).
	handle {
		root * /srv
		header Cache-Control "no-cache"
		header Referrer-Policy no-referrer
		encode zstd gzip
		try_files {path} /index.html
		file_server
	}

	handle_errors {
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
