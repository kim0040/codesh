# gachipad production settings. Copy to deploy/.env (the install script does this for you) and fill the
# empty secrets with ./generate-secrets.sh. Never commit .env. Values are read by docker-compose.yml.

# --- Images -----------------------------------------------------------------------------------
# Release version for the gachipad image set. update.sh, install.sh and upgrade.sh keep it up to date.
GACHIPAD_VERSION=1.0.1
# Where `docker compose pull` gets them: the public GitHub packages, or a mirror of your own.
GACHIPAD_REGISTRY=ghcr.io/kim0040
# sqlite (default), postgres (bundled), mongodb (bundled), or external (DATABASE_URL required).
GACHIPAD_DB=sqlite
# Internal URL for bundled PostgreSQL/MongoDB or the default SQLite file; do not edit directly.
GACHIPAD_DATABASE_URL=sqlite:///data/gachipad.db
# Set DATABASE_URL for an external PostgreSQL, MySQL/MariaDB or MongoDB server.
#DATABASE_URL=
# Optional overrides; the updater pins these automatically when reusing an older installation.
#GACHIPAD_PROJECT=gachipad
#MONGO_ROOT_USER=gachipad
#MONGO_APP_USER=gachipad_app
#MONGO_DATABASE=gachipad

# --- Network ----------------------------------------------------------------------------------
# Host ports of Caddy (the only published service).
HTTP_PORT=80
HTTPS_PORT=443
# What Caddy answers to. ":80" is plain HTTP on any host name or IP. A host name such as
# gachipad.local turns on HTTPS; add a `tls` directive in deploy/tls/*.caddy (see deploy/README.md).
SITE_ADDRESS=:80
# Extra site addresses, including the leading comma and space; set automatically on upgrade.
SITE_ALIASES=
# Origin users type in the browser, no trailing slash, e.g. https://gachipad.local. Used for OIDC redirect
# URIs and the Secure flag of the session cookie. Empty is fine for plain HTTP on an IP.
PUBLIC_URL=
# Subnet of the compose network. Change it only if it overlaps a network of the host.
NETWORK_SUBNET=172.29.88.0/24
# CIDRs of the reverse proxy in front of the API (Caddy). Defaults to NETWORK_SUBNET; leave it commented
# unless NETWORK_SUBNET is not where Caddy runs. Empty makes every user share one rate limit.
#TRUST_PROXY=172.29.88.0/24
# CIDRs of a load balancer in front of Caddy whose X-Forwarded-For Caddy should keep.
#CADDY_TRUSTED_PROXIES=127.0.0.1/32

# --- Secrets (generate-secrets.sh fills the empty ones; at least 32 characters) --------------
# Signs the gachipad_sid session cookie.
SESSION_SECRET=
# Signs the collab tokens the API hands to the editor; api and collab must share it.
COLLAB_SECRET=
# Bearer token of /api/admin/*. Empty disables the admin API. Generate: openssl rand -hex 32.
# Use HTTPS: the token is sent with every admin request. Restrict ADMIN_ALLOW_CIDR as well.
ADMIN_TOKEN=
# Optional comma-separated CIDRs allowed to reach the admin API; empty allows any client IP.
# IPv4 and IPv6 are separate: list both families when clients use both (e.g. 10.0.0.0/8,fd00::/8).
ADMIN_ALLOW_CIDR=
# MongoDB root user "gachipad", used only by mongo-users, backup.sh and restore.sh. Set before the
# first start: it only seeds a new volume.
MONGO_PASSWORD=
# MongoDB user "gachipad_app" (readWrite on database gachipad) that api and collab use. mongo-users
# creates it, or resets it to this value, on every start, also on volumes from older versions.
MONGO_APP_PASSWORD=
# PostgreSQL 17 bundled-service password; generated only when GACHIPAD_DB=postgres.
POSTGRES_PASSWORD=
POSTGRES_DATABASE=gachipad
POSTGRES_USER=gachipad_app
# Valkey requirepass.
VALKEY_PASSWORD=

# --- Updates (docs/OPERATIONS.md "업데이트") ----------------------------------------------------
# on: the api asks GitHub for the latest release a few minutes after start and about every 12 h, a
# plain GET of https://api.github.com/repos/<UPDATE_REPO>/releases/latest with nothing but
# "User-Agent: gachipad/<version>". off: no outbound request at all. Without internet it fails quietly.
UPDATE_CHECK=on
UPDATE_REPO=kim0040/gachipad
# stable, or prerelease to also be offered release candidates.
UPDATE_CHANNEL=stable
# Outbound proxy for the update check (also used by OIDC discovery unless NO_PROXY names the host).
#HTTPS_PROXY=http://proxy.example:3128
#NO_PROXY=sso.example

# --- Capacity ---------------------------------------------------------------------------------
# Number of collab instances (also: docker compose up -d --scale collab=N). Caddy spreads documents over them.
COLLAB_REPLICAS=1
# Milliseconds a busy document (8+ people) batches cursor updates before sending them; 0 sends each at once.
# COLLAB_BROADCAST_WINDOW_MS=30
# WiredTiger cache of MongoDB in GB.
MONGO_CACHE_GB=2
# Valkey protects join codes, locks and security counters with noeviction. New storage/profile/SSE
# writes stop at 90% of maxmemory; reads use bounded fallback limits if new counters hit OOM.
VALKEY_MAXMEMORY=1gb

# --- Rate limits (requests per client IP and minute, per bucket) -----------------------------
# Raise them for a load test from one machine; the defaults suit normal use.
RATE_LIMIT_API_PER_MIN=1200
RATE_LIMIT_CODE_PER_MIN=30
RATE_LIMIT_CREATE_PER_MIN=60
RATE_LIMIT_LOGIN_PER_MIN=10

# --- Optional: gachipad.local on the LAN (mDNS) -------------------------------------------------
# generate-secrets.sh keeps mdns while adding or removing the selected database profile.
COMPOSE_PROFILES=
MDNS_HOSTNAME=gachipad.local
# Additional names answered by the optional mDNS service, separated by commas.
MDNS_ALIASES=
# Address to advertise when the host has several; empty advertises all non-loopback IPv4 addresses.
MDNS_IP=

# Storage ingress quotas per fixed window; IP means IPv4 address or IPv6 /64.
QUOTA_WINDOW_SECONDS=86400
QUOTA_SHARES_PER_CLIENT=200
QUOTA_SHARES_PER_IP=1000
QUOTA_UPLOADS_PER_CLIENT=200
QUOTA_UPLOADS_PER_IP=1000
QUOTA_BYTES_PER_CLIENT=536870912
QUOTA_BYTES_PER_IP=2147483648
UPLOAD_STORAGE_MAX_BYTES=10737418240
SSE_MAX_PER_CLIENT=20
SSE_MAX_PER_IP=200
PRESENCE_MAX_PER_NET=500
PENDING_MAX_PER_SHARE=100
BROADCASTS_PER_MIN=5
BROADCAST_FANOUT_MAX=500
