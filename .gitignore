# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
.turbo/
coverage/
*.tsbuildinfo

# env and secrets
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# test artifacts
playwright-report/
test-results/

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# local data
.data/
*.sqlite
.box-out/

# deploy
deploy/backups/
deploy/.env
# Written by deploy/update.sh (status, log, auto-update settings, rollback copies).
deploy/state/*
!deploy/state/.gitkeep

# TLS private material; only documentation and opt-in examples are tracked.
deploy/tls/*
!deploy/tls/README.md
!deploy/tls/*.example
