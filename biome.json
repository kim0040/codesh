{
  "files": {
    "includes": [
      "**",
      "!**/*.md",
      "!**/node_modules",
      "!**/dist",
      "!**/.turbo",
      "!**/.box-out",
      "!**/routeTree.gen.ts",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
